# TMDB — metadata + posters for the whole catalog (free: https://www.themoviedb.org/settings/api)
# v4 read token (recommended, JWT-looking) OR v3 key, either works with scripts/tmdb-sync.mjs
TMDB_API_TOKEN=
TMDB_API_KEY_READ=

# Extra hosts you are licensed/authorised to frame, comma separated.
# drive.google.com, youtube-nocookie.com, player.vimeo.com are already allowed.
# Adding a host here is a licensing decision, not a technical one.
EMBED_HOST_ALLOWLIST=

# Optional: shown in the player footer so viewers know where art comes from
NEXT_PUBLIC_TMDB_ATTRIBUTION=1
